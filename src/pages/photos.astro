---
import '../styles/global.css';

const PHOTOS = [
  { src: '/images/FullSizeRender_VSCO.jpeg', alt: '' },
  { src: '/images/IMG_1200.jpeg', alt: '' },
  { src: '/images/b451212d-4d28-42fd-be21-b9206fb518f6.jpeg', alt: '' },
  { src: '/images/07e599a9-5d25-48de-a876-c0a64520c4a7.jpeg', alt: '' },
  { src: '/images/IMG-20180309-WA0004.jpeg', alt: '' },
  { src: '/images/IMG_3582.png', alt: '' },
  { src: '/images/a2d03267-10d2-4e64-b8ad-ac88c519da50.jpeg', alt: '' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <title>Photos · Ibrahim Nasaruddin</title>
    <style>
      .ph-grid{
        columns:3; column-gap:12px; margin-top:40px;
      }
      @media(max-width:820px){ .ph-grid{ columns:2; } }
      @media(max-width:520px){ .ph-grid{ columns:1; } }
      .ph-item{
        break-inside:avoid; margin-bottom:12px; border-radius:10px; overflow:hidden;
        cursor:zoom-in; display:block;
        border:1px solid var(--line);
        transition:opacity .2s, transform .2s;
      }
      .ph-item:hover{ opacity:.88; transform:scale(.995); }
      .ph-item img{ width:100%; height:auto; display:block; }

      /* lightbox */
      .ph-lb{
        display:none; position:fixed; inset:0; z-index:200;
        background:rgba(0,0,0,.92); backdrop-filter:blur(6px);
        align-items:center; justify-content:center; padding:24px;
      }
      .ph-lb.open{ display:flex; animation:ph-fade .2s ease; }
      .ph-lb img{
        max-width:100%; max-height:90vh; border-radius:8px;
        object-fit:contain; box-shadow:0 32px 80px rgba(0,0,0,.6);
      }
      .ph-lb-close{
        position:fixed; top:20px; right:20px; width:38px; height:38px; border-radius:8px;
        border:1px solid rgba(255,255,255,.2); background:rgba(0,0,0,.4);
        color:#fff; font-size:18px; cursor:pointer; display:grid; place-items:center;
        transition:.2s;
      }
      .ph-lb-close:hover{ border-color:rgba(255,255,255,.6); }
      @keyframes ph-fade{ from{ opacity:0; } to{ opacity:1; } }
    </style>
  </head>
  <body style="margin:0;padding:0;">
    <div class="ip-root light">

      <nav class="ip-nav">
        <div class="ip-wrap ip-nav-in">
          <a href="/" class="ip-brand"><span class="dot"></span>IBRAHIM_N</a>
          <div class="ip-nav-links">
            <a href="/" class="ip-nav-back">← Portfolio</a>
          </div>
        </div>
      </nav>

      <main class="ip-wrap" style="padding-top:56px; padding-bottom:80px;">
        <div class="ip-sec-head">
          <span class="ip-sec-idx">—</span>
          <span class="ip-sec-title">Photos</span>
          <span class="ip-sec-line"></span>
        </div>

        <div class="ph-grid">
          {PHOTOS.map((p, i) => (
            <button class="ph-item" data-src={p.src} data-idx={i} aria-label="View photo">
              <img src={p.src} alt={p.alt} loading={i === 0 ? 'eager' : 'lazy'} />
            </button>
          ))}
        </div>
      </main>

      <div class="ph-lb" id="lb">
        <button class="ph-lb-close" id="lb-close">✕</button>
        <img id="lb-img" src="" alt="" />
      </div>

    </div>

    <script>
      const lb   = document.getElementById('lb');
      const img  = document.getElementById('lb-img');
      const close = document.getElementById('lb-close');

      document.querySelectorAll('.ph-item').forEach(btn => {
        btn.addEventListener('click', () => {
          img.src = btn.dataset.src;
          lb.classList.add('open');
        });
      });

      const closeLb = () => lb.classList.remove('open');
      close.addEventListener('click', closeLb);
      lb.addEventListener('click', e => { if (e.target === lb) closeLb(); });
      document.addEventListener('keydown', e => { if (e.key === 'Escape') closeLb(); });
    </script>
  </body>
</html>

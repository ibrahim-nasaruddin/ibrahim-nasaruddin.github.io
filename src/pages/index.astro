---
import '../styles/global.css';
import Portfolio from '../components/Portfolio.jsx';

const gaId = import.meta.env.PUBLIC_GA_ID;

// Fetch Substack RSS at build time — graceful fallback to empty array on failure
let articles = [];
try {
  const res = await fetch('https://thesportcipher.substack.com/feed');
  const xml = await res.text();

  // Extract the publication logo image ID so we can skip it when used as article art
  const logoBlock = xml.match(/<image>([\s\S]*?)<\/image>/)?.[1] ?? '';
  const logoId = logoBlock.match(/images%2F([a-f0-9-]+)/)?.[1] ?? '';

  const stripHtml = (html) =>
    html
      .replace(/<[^>]+>/g, ' ')
      .replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>')
      .replace(/&#39;/g, "'").replace(/&quot;/g, '"')
      .replace(/\s+/g, ' ').trim();

  const parseItems = (src) => {
    const items = [];
    let pos = 0;
    while (true) {
      const s = src.indexOf('<item>', pos);
      if (s === -1) break;
      const e = src.indexOf('</item>', s);
      if (e === -1) break;
      const block = src.slice(s + 6, e);
      pos = e + 7;

      const field = (name) => {
        const cd = block.match(
          new RegExp('<' + name + '><!\\[CDATA\\[([\\s\\S]*?)\\]\\]><\\/' + name + '>')
        );
        if (cd) return cd[1].trim();
        const pl = block.match(new RegExp('<' + name + '>([^<]*)<\\/' + name + '>'));
        return pl ? pl[1].trim() : '';
      };

      const rawImg = block.match(/<enclosure[^>]+url="([^"]+)"/)?.[1] ?? '';
      const imgId  = rawImg.match(/images%2F([a-f0-9-]+)/)?.[1] ?? '';
      const img    = imgId && imgId !== logoId ? rawImg : '';

      const rawDate = field('pubDate');
      const date = rawDate
        ? new Date(rawDate).toLocaleDateString('en-GB', {
            day: 'numeric', month: 'short', year: 'numeric',
          })
        : '';

      const rawDesc   = field('description');
      const cleanDesc = stripHtml(rawDesc);
      const desc = cleanDesc.length > 155
        ? cleanDesc.slice(0, 155).trimEnd() + '…'
        : cleanDesc;

      items.push({ title: field('title'), link: field('link'), desc, img, date });
    }
    return items;
  };

  articles = parseItems(xml).filter(
    (a) => a.title && !a.title.toLowerCase().includes('coming soon')
  );
} catch {
  // articles stays []
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Ibrahim Nasaruddin — Sport Analytics portfolio. Projects spanning football analytics, performance science, and machine learning in sport." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <title>Ibrahim Nasaruddin · Sport Analytics</title>
    {gaId && import.meta.env.PROD && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script is:inline define:vars={{ gaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          window.gtag = gtag;
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}
  </head>
  <body style="margin:0;padding:0;">
    <Portfolio articles={articles} client:load />
  </body>
</html>
